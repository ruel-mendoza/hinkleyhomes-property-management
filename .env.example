# Environment variables for Hinkley Homes PMS.
# Set real values in Replit -> Tools -> Secrets. Never put real values in this
# file or commit a .env file; this file only documents the names.

# --- Database (Supabase) ------------------------------------------------------
# Session pooler string (not the db.<ref>.supabase.co direct host).
# DATABASE_URL is reserved by Replit and is not used.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# --- Auth (Clerk) -------------------------------------------------------------
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: exact address of COHO's Transactions page, opened by the
# "Reconcile in COHO" buttons on the Rent bank feed (defaults to https://app.coho.life).
VITE_COHO_TRANSACTIONS_URL=

# --- COHO ---------------------------------------------------------------------
# API key for the COHO Public API v1.1. Server-side only.
COHO_API_KEY=

# --- Smoobu (Hinkley Homes Stays) --------------------------------------------
# API key from Smoobu -> Settings -> Advanced -> API Keys. With only
# SMOOBU_API_KEY the old Api-Key header is used, which Smoobu switches off on
# 31 October 2026. Add SMOOBU_API_SECRET (an HMAC key; the secret is shown once)
# and every request is signed instead. Tick "Guest Data (PII)" on an HMAC key or
# guest names come back blank. Read-only use: the app never changes bookings,
# prices or availability.
SMOOBU_API_KEY=
SMOOBU_API_SECRET=

# --- Scheduled sync (n8n -> PMS API) ------------------------------------------
# Shared key for POST /api/integrations/coho/actions/sync, sent by the
# n8n/coho-actions-sync.workflow.json schedule as header X-Hinkley-Sync-Key.
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PMS_SYNC_KEY=

# --- Xero via n8n (in use) ----------------------------------------------------
# Production URL of the "Hinkley PMS – Xero gateway" webhook
# (n8n/xero-gateway.workflow.json), e.g.
#   https://<your-instance>.app.n8n.cloud/webhook/hinkley-xero-gateway
N8N_XERO_GATEWAY_URL=
# Same value as the "X-Hinkley-Gateway-Key" Header Auth credential in n8n.
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
N8N_XERO_GATEWAY_KEY=
# Production URL of the "PMS: run action" webhook in the n8n workflow
# n8n/xero-overdue-reminders.workflow.json (send a reminder now, re-send a Xero
# invoice, add a Xero note). Uses N8N_XERO_GATEWAY_KEY as its header key.
N8N_REMINDER_WEBHOOK_URL=

# --- Xero direct OAuth (not used while the n8n gateway is in place) -----------
# From developer.xero.com -> My Apps -> your Web app -> Configuration.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Xero app.
XERO_REDIRECT_URI=https://<your-app>.replit.app/api/xero/callback
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts the Xero refresh tokens stored in the database. Changing it means
# every Xero organisation must be reconnected.
XERO_TOKEN_ENCRYPTION_KEY=
# Optional. Space-separated; must be scopes your Xero app is allowed to request.
# Default: offline_access accounting.settings.read accounting.contacts accounting.transactions
XERO_SCOPES=
# Optional until Xero webhooks are switched on for the app.
XERO_WEBHOOK_KEY=
