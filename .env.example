# Environment variables for Hinkley Homes PMS.
# Set real values in Replit -> Tools -> Secrets. Never put real values in this
# file or commit a .env file; this file only documents the names.

# --- Database (Supabase) ------------------------------------------------------
# Session pooler string (not the db.<ref>.supabase.co direct host).
# DATABASE_URL is reserved by Replit and is not used.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# --- Auth (Clerk) -------------------------------------------------------------
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# --- COHO ---------------------------------------------------------------------
# API key for the COHO Public API v1.1. Server-side only.
COHO_API_KEY=

# --- Xero ---------------------------------------------------------------------
# From developer.xero.com -> My Apps -> your Web app -> Configuration.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Xero app.
XERO_REDIRECT_URI=https://<your-app>.replit.app/api/xero/callback
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts the Xero refresh tokens stored in the database. Changing it means
# every Xero organisation must be reconnected.
XERO_TOKEN_ENCRYPTION_KEY=
# Optional. Space-separated; must be scopes your Xero app is allowed to request.
# Default: offline_access accounting.settings.read accounting.contacts accounting.transactions
XERO_SCOPES=
# Optional until Xero webhooks are switched on for the app.
XERO_WEBHOOK_KEY=
